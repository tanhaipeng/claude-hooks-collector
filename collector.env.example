# Copy to collector.env; collector.env is gitignored.
# Langfuse self-host OTLP endpoint (v3.22+ / v4)
OTLP_ENDPOINT=http://127.0.0.1:3000/api/public/otel
# base64("pk-lf-...:sk-lf-..."): printf '%s' 'pk-lf-...:sk-lf-...' | base64
OTLP_HEADERS='Authorization=Basic <BASE64_PUBLIC_SECRET>,x-langfuse-ingestion-version=4'
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_AUTH=<BASE64_PUBLIC_SECRET>
